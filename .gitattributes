# 默认：交由 Git 自动识别文本文件，仓库内统一 LF
* text=auto eol=lf

# Windows 脚本保持 CRLF
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Shell 脚本强制 LF
*.sh   text eol=lf

# 二进制文件，禁止行尾转换
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.docx  binary
*.xlsx  binary
*.pptx  binary
*.zip   binary
*.jar   binary

*.java  linguist-language=Java
*.sql   linguist-language=SQL
*.md    text
